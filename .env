# ============================================================
# DJANGO CORE
# ============================================================
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-abc123xyz
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

FRONTEND_URL=http://localhost:5173

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://mkcdp:mkcdp@localhost:5432/mkcdp

# ============================================================
# REDIS / CELERY
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# ============================================================
# CORS
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# EMAIL  (leave EMAIL_HOST blank to print codes to console)
# ============================================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MKCDP <noreply@mkcdp.local>

# ============================================================
# MPESA
# ============================================================
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://127.0.0.1:8000/api/payments/webhooks/mpesa/

# ============================================================
# CARD (Stripe)
# ============================================================
CARD_PROVIDER=stripe
CARD_SECRET_KEY=
CARD_PUBLISHABLE_KEY=
CARD_WEBHOOK_SECRET=

# ============================================================
# BANK TRANSFER DETAILS
# ============================================================
BANK_NAME=Equity Bank Kenya
BANK_ACCOUNT_NAME=MKCDP Foundation
BANK_ACCOUNT_NUMBER=0123456789012
BANK_BRANCH=Westlands
BANK_SWIFT=EQBLKENA

# ============================================================
# MISC
# ============================================================
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/KES
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7
CODE_TTL_MINUTES=10
SIGNIN_INACTIVITY_DAYS=14